TZ=Asia/Shanghai

# 必填。多条订阅用 | 分隔
sub_url=https://your-subscription-url.com

# 订阅更新。off 表示不建定时任务。默认每天 4:00，过频可能导致订阅被封
cron=0 4 * * *

# 面板 / Clash API 密钥。留空则首次启动生成并写入数据卷
# 局域网不想输密钥时设为 off（不要把 9090 暴露到公网）
SECRET=

# 家庭网关需要 true，否则局域网设备连不上 mixed 端口
ALLOW_LAN=true
MIXED_PORT=7890
CONTROLLER_PORT=9090

# 可选：subconverter 外部规则模板
config_url=

# 可选：转换失败时 POST JSON {status,message}
NOTIFY_WEBHOOK=

# 家庭订阅出口（映射 25500 时使用）。留空则首次启动生成
SUB_TOKEN=

# 仅作文档标记；是否对外提供转换口由 compose 是否映射 25500 决定
EXPOSE_SUB_API=false
